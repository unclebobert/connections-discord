# Discord application credentials. On the server these live in a systemd
# EnvironmentFile at mode 0600, not in the repository.
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# Bind port. Caddy reverse-proxies to this on 127.0.0.1.
PORT=8787

# SQLite file. Any directory the service user can write.
DATABASE_PATH=/var/lib/connections/connections.sqlite
